{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --include=dev && npm run build && cd server && npm install"
  },
  "deploy": {
    "startCommand": "cd server && npx tsx src/index.ts",
    "restartPolicyType": "ON_FAILURE"
  }
}
