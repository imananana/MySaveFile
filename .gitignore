# Raw product screenshots — 80MB+ of full-res PNGs that would sit in every
# clone forever. The recipe that produces them is tracked; the images aren't,
# and the handful the landing page actually ships live in public/landing/.
mockups/screenshots/*.png
mockups/screenshots/content/
