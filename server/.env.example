DATABASE_PATH=./data/planner.db
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-random-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
CLIENT_URL=http://localhost:5173
PORT=3001

# Comma-separated allowlist for the owner dashboard at /admin. Compared
# lower-cased against users.email. Empty or unset = nobody is an admin and
# every /api/admin route 404s.
ADMIN_EMAILS=

# Optional. Comma-separated addresses left out of every dashboard statistic
# (along with their plus-addressed variants and anything @mysavefile.com).
# Unset = ADMIN_EMAILS is used, which is right for a one-owner site; set it only
# when the two lists should differ.
INTERNAL_EMAIL=
